<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Inherit Purchase Order Form View - ONLY add bracket info, no UI changes -->
    <record id="view_purchase_order_form_approval" model="ir.ui.view">
        <field name="name">purchase.order.form.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Add approval bracket information in Other Information tab -->
            <xpath expr="//page[@name='purchase_delivery_invoice']//group[@name='invoice_info']" position="after">
                <group name="approval_bracket_info" string="Approval Bracket" attrs="{'invisible': [('approval_bracket_id', '=', False)]}">
                    <field name="approval_bracket_id" readonly="1"/>
                    <field name="bracket_approver_ids" widget="many2many_tags" readonly="1"/>
                    <field name="destination_location_id" readonly="1"/>
                </group>
            </xpath>

        </field>
    </record>

    <!-- Inherit Purchase Order Tree View - ONLY add bracket column -->
    <record id="view_purchase_order_tree_approval" model="ir.ui.view">
        <field name="name">purchase.order.tree.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="approval_bracket_id" optional="hide"/>
            </xpath>

        </field>
    </record>

    <!-- Add search filter for pending approvals -->
    <record id="view_purchase_order_search_approval" model="ir.ui.view">
        <field name="name">purchase.order.search.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">

            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Pending My Approval" name="pending_my_approval"
                        domain="[('state', '=', 'to approve'), ('bracket_approver_ids', 'in', [uid])]"
                        help="Purchase orders waiting for my approval"/>
                <separator/>
                <filter string="Approval Bracket" name="group_approval_bracket"
                        context="{'group_by': 'approval_bracket_id'}"/>
            </xpath>

        </field>
    </record>

</odoo>
